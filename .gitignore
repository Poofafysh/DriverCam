# build output
**/bin/
**/obj/

# personal settings (your game path), see source/local.props.example
source/local.props

# personal backups (game saves, downloaded BepInEx zip)
backup/
*.blend1

# game-owned car models exported for reference (don't redistribute)
source/DriverCam/Assets/cars/

# game-owned assets / dumps (don't redistribute). Anchored to the repo root: git on Windows ignores case,
# so a bare "assets/" would also hide source/DriverCam/Assets/.
/VehicleAssets/
/dump/
/assets/
# third-party low-poly reference car (check its license before sharing)
car and interior/

# binaries: this repo is source only. BepInEx and built plugins are not committed.
BepInEx/
dotnet/
*.dll
*.exe
*.pdb
*.zip
winhttp.dll
doorstop_config.ini
.doorstop_version

# packaged releases
release/

# Python bytecode (Blender runs of the interior scripts)
__pycache__/
*.pyc

# local session state (tools/ownership.ps1), never commit
.claude/ownership.md

# DriverCam interior build intermediates: the layout-1 base cockpits carry the game's own car body (autofit.py copies
# the prefab body into the Shell / Doors groups). build_interior.py reads them from git into the temp folder; never
# keep a copy here.
source/DriverCam/Assets/interiors/base/
source/DriverCam/Assets/interiors/**/*.dcm

# Sketchfab-sourced car/bike models and textures (CC-BY / unverified licences): kept local, never pushed
source/CarSkins/Assets/*.csm
source/CarSkins/Assets/*_basecolor.*
